FROM ubuntu:22.04 AS builder

ARG RUST_VERSION=1.83.0

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl pkg-config \
        libadwaita-1-dev libasound2-dev libgtk-4-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain "$RUST_VERSION"
ENV PATH=/root/.cargo/bin:$PATH

WORKDIR /src
COPY . .

RUN scripts/bootstrap.sh \
    && scripts/check.sh \
    && packaging/build-release.sh

FROM ubuntu:22.04 AS smoke-test

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        dbus-x11 libadwaita-1-0 libasound2 libdbus-1-3 libgtk-4-1 \
        libx11-6 libxi6 libxtst6 xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/dist/ /tmp/

RUN set -eu; \
    ! command -v cargo; \
    cd /tmp; \
    archive=$(find . -maxdepth 1 -name 'echo-linux-x86_64-*.tar.gz' -print -quit); \
    test -n "$archive"; \
    sha256sum -c "$archive.sha256"; \
    tar -xzf "$archive"; \
    root=${archive%.tar.gz}; \
    ldd "$root/echo" | tee /tmp/echo-ldd.txt; \
    ! grep -F 'not found' /tmp/echo-ldd.txt; \
    if timeout 3s xvfb-run -a env GDK_BACKEND=x11 dbus-run-session -- "$root/echo"; then exit 1; else test "$?" -eq 124; fi

FROM scratch AS archive

COPY --from=builder /src/dist/ /
